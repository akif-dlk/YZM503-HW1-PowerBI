{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "line1",
  "position": {
    "x": 30,
    "y": 30,
    "z": 0,
    "height": 495,
    "width": 1230,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimDate"
                    }
                  },
                  "Property": "EnglishMonthName"
                }
              },
              "queryRef": "DimDate.EnglishMonthName",
              "nativeQueryRef": "EnglishMonthName",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimDate"
                    }
                  },
                  "Property": "CalendarYear"
                }
              },
              "queryRef": "DimDate.CalendarYear",
              "nativeQueryRef": "CalendarYear",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactInternetSales"
                    }
                  },
                  "Property": "Toplam Satış"
                }
              },
              "queryRef": "FactInternetSales.Toplam Satış",
              "nativeQueryRef": "Toplam Satış"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Aylara ve Yıllara Göre Satış Trendi'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "14D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}